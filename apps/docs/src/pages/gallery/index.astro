---
import ComponentPreview from '../../components/gallery/ComponentPreview.tsx'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { CATEGORY_ORDER } from '../../lib/categories'
import { getComponents, isReleased } from '../../lib/registry'

const components = getComponents()
const groups = CATEGORY_ORDER
  .map((category) => ({ category, items: components.filter((i) => i.category === category) }))
  .filter((g) => g.items.length > 0)
---

<BaseLayout
  title="Component gallery — Runek"
  description="Browse every Runek component as a live, seeded 3D preview."
>
  <main class="gallery">
    <header class="gallery-head">
      <p class="eyebrow">Gallery</p>
      <h1>Every component, live</h1>
      <p class="summary">
        Each preview is the real component, generated from a seed: drag to orbit. Open one for its props (with defaults), install command, and source.
      </p>
    </header>

    {
      groups.map((group) => (
        <section class="gallery-section">
          <h2>{group.category}</h2>
          <div class="grid">
            {group.items.map((item) => (
              <div class="card">
                <ComponentPreview client:visible title={item.title} />
                <div class="card-meta">
                  <a class="card-title" href={`/docs/components/${item.name}`}>
                    {item.title}
                  </a>
                  {!isReleased(item.name) && <span class="badge-unreleased">unreleased</span>}
                  <a class="card-lab" href={`/workshop#m=lab&c=${item.title}`}>open in the workshop →</a>
                  <p>{item.description}</p>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </main>
</BaseLayout>
