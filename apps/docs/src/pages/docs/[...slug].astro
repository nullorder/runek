---
import { Code } from 'astro:components'
import { getCollection, render } from 'astro:content'
import ComponentPreview from '../../components/gallery/ComponentPreview.tsx'
import DocLayout from '../../layouts/DocLayout.astro'
import { getManifest } from '../../lib/registry'

export async function getStaticPaths() {
  const docs = await getCollection('docs')
  return docs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
// Component docs carry a live, slowly rotating preview of the real component.
const isComponent = entry.data.category === 'component' && Boolean(entry.data.component)
const files = isComponent ? getManifest(entry.data.component as string).files : []
---

<DocLayout
  title={entry.data.title}
  summary={entry.data.summary}
  eyebrow={entry.data.category}
  slug={entry.id}
>
  {
    isComponent && (
      <div class="doc-preview" data-pagefind-ignore>
        <ComponentPreview client:visible title={entry.data.title} />
        <a class="doc-preview__lab" href={`/workshop#m=lab&c=${entry.data.title}`}>
          Tune every prop in the workshop →
        </a>
      </div>
    )
  }
  <Content />
  {
    files.length > 0 && (
      <details class="doc-source" data-pagefind-ignore>
        <summary>
          Source <span>({files.length === 1 ? files[0].path : `${files.length} files`})</span>
        </summary>
        {files.map((file) => (
          <section>
            {files.length > 1 && <p class="doc-source__path">{file.path}</p>}
            <Code code={file.content} lang={file.path.endsWith('.json') ? 'json' : 'tsx'} theme="night-owl" />
          </section>
        ))}
      </details>
    )
  }
</DocLayout>
