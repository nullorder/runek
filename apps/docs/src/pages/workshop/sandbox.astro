---
import Sandbox from '../../workshop/sandbox/Sandbox.tsx'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Runek workshop sandbox</title>
    <style is:global>
      html, body { margin: 0; height: 100%; overflow: hidden; background: #0b0d12; color: #cfe6db; }
      body > astro-island, #root { display: block; height: 100%; }
      canvas { display: block; }
      .sandbox-failed {
        display: grid; place-items: center; height: 100%;
        font: 13px ui-monospace, SF Mono, Menlo, monospace; color: #ff8a8a;
      }
    </style>
  </head>
  <body>
    <Sandbox client:only="react" />
  </body>
</html>
